  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.9.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "0.28.1",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.28",
    "postcss": "8.4.49",
